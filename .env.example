# Copy to .env.local, or use npm run setup:field to generate the local field settings.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Generated locally by npm run setup:field. Keep the control code and private key secret.
NIGHTWATCH_CONTROL_CODE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:field@example.com

# Set only when using a trusted HTTPS deployment or development tunnel.
# NIGHTWATCH_PUBLIC_ORIGIN=https://your-tunnel-host.example
